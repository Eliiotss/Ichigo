<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ichigo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ichigo_page_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Keep the branded cream splash even in dark mode (the logo is light-ground);
         transparent icon so it's a single loading screen, not a double splash. -->
    <style name="Theme.Ichigo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ichigo_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="postSplashScreenTheme">@style/Theme.Ichigo</item>
    </style>
</resources>
