<?xml version="1.0" encoding="utf-8"?>
<!--
    Fully transparent icon for the platform SplashScreen. The Android 12+ cold-
    start splash is mandatory, so instead of showing the app icon (which would
    read as a second, separate splash before the in-app "IchiGo" wordmark loading
    screen) we show nothing but the cream background here. That makes the native
    splash flow seamlessly into the single branded loading screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
